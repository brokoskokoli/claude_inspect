{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["svelte", "vite/client"],
    "paths": { "$shared/*": ["./src/shared/*"] }
  },
  "include": ["web/src/**/*.ts", "web/src/**/*.svelte", "src/shared/**/*.ts"]
}
