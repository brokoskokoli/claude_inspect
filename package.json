{
  "name": "claude-inspect",
  "version": "0.7.1",
  "description": "Claude Code dashboard & monitor: live sessions, subagents, spawned claude workers, tool calls, timelines, CPU and token usage and transcript history – read passively from ~/.claude, no hooks.",
  "keywords": [
    "claude-code",
    "claude",
    "anthropic",
    "ai-agents",
    "agent-observability",
    "subagents",
    "observability",
    "dashboard",
    "developer-tools",
    "llm",
    "transcripts",
    "token-usage",
    "svelte",
    "typescript",
    "claude-code-tools",
    "monitoring",
    "cli",
    "local-first",
    "ai-tools",
    "usage"
  ],
  "homepage": "https://brokoskokoli.github.io/claude_inspect/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brokoskokoli/claude_inspect.git"
  },
  "bugs": {
    "url": "https://github.com/brokoskokoli/claude_inspect/issues"
  },
  "license": "MIT",
  "author": "brokoskokoli",
  "type": "module",
  "bin": {
    "claude-inspect": "dist/app/server/cli.js"
  },
  "files": [
    "dist/app",
    "dist/web",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node dist/app/server/cli.js --open",
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server/cli.ts --dev",
    "dev:web": "vite",
    "demo": "tsx src/server/cli.ts demo --open",
    "service:install": "tsx src/server/cli.ts service install",
    "service:uninstall": "tsx src/server/cli.ts service uninstall",
    "service:status": "tsx src/server/cli.ts service status",
    "check": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.web.json",
    "test": "tsx --test \"src/**/*.test.ts\" \"tests/**/*.test.ts\"",
    "test:update": "node -e \"process.env.UPDATE_SNAPSHOTS='1'; require('node:child_process').execSync('npm test', { stdio: 'inherit' })\"",
    "smoke": "tsx scripts/smoke.ts",
    "snapshot": "tsx src/server/cli-snapshot.ts",
    "fixtures": "tsx scripts/make-fixtures.ts",
    "calibrate": "tsx scripts/calibrate-budget.ts",
    "prepublishOnly": "npm run check && npm test && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@types/node": "^26.6.3",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^6.4.3"
  }
}
